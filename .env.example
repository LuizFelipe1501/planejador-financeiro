# Supabase (projeto "caderno-gastos" já criado, região sa-east-1)
SUPABASE_URL=https://pumepyunvrbnwxkoakfn.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...          # pegue em Settings > API > service_role (secreta!)

# Gemini (Google AI Studio > Get API key)
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-3.5-flash-lite        # confira o ID atual no AI Studio

# WhatsApp: provedor ('twilio' recomendado para teste, ou 'meta')
WHATSAPP_PROVIDER=twilio

# Twilio (Console: Account SID + Auth Token; sandbox From)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Meta Cloud API (só se WHATSAPP_PROVIDER=meta)
WHATSAPP_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=1234567890
WHATSAPP_VERIFY_TOKEN=algum-texto-secreto
GRAPH_API_VERSION=v23.0

# Relatório agendado: no Twilio sandbox deixe false (manda texto simples)
WHATSAPP_USE_TEMPLATE=false
REPORT_TEMPLATE_NAME=resumo_mensal
REPORT_TEMPLATE_LANG=pt_BR

# URL pública do app (usada pra montar o link pessoal do painel no onboarding)
APP_URL=https://caderno-gastos.vercel.app

# Trava de teste (OPCIONAL): se preenchida, só esses números conseguem usar/
# onboardar. Deixe VAZIA para abrir o cadastro automático a qualquer número.
# Multiusuário: os destinatários do relatório vêm da tabela users, não daqui.
ALLOWED_NUMBERS=5561999998888

# Dashboard (senha simples pra ver os gastos)
DASHBOARD_TOKEN=uma-senha-forte

# Cron (o Vercel injeta esse header no /api/report automaticamente)
CRON_SECRET=outra-senha-forte

# Número do bot para o botão flutuante do painel (só dígitos, com DDI).
# Se vazio, o painel usa o número do TWILIO_WHATSAPP_FROM automaticamente.
WHATSAPP_BOT_NUMBER=

# Frase de entrada do sandbox Twilio (o botão "Ativar WhatsApp" já a pré-preenche)
TWILIO_JOIN_CODE=letter-divide
